# ═══════════════════════════════════════════════════════════════════
# VCOO Virtual — Variables de Entorno
# ═══════════════════════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores.
# Las variables marcadas como [OBLIGATORIO] son necesarias para arrancar.
# Las marcadas como [OPCIONAL] se pueden dejar vacías, pero limitan funciones.
# ═══════════════════════════════════════════════════════════════════

# ─── API Keys [OBLIGATORIO] ───────────────────────────────────────
# Proveedor LLM principal (OpenRouter). Necesario para que el agente funcione.
OPENROUTER_API_KEY=

# Tokens de bots para canales de comunicación
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# ─── Home Channel [OBLIGATORIO - Discord] ─────────────────────────
# ID del canal de Discord donde el agente VCOO entregará sus mensajes
# por defecto. Se configura durante el配对 (pairing) o con esta variable.
# Ejemplo: 1519113868411146391 → 🤖・testing
DISCORD_HOME_CHANNEL=

# ─── Trello [OPCIONAL] ────────────────────────────────────────────
# Si no se configuran, el módulo PLANNER se salta automáticamente.
TRELLO_API_KEY=
TRELLO_TOKEN=

# ─── NVIDIA Fallback [OPCIONAL] ───────────────────────────────────
# Si OpenRouter da rate-limit, se usa NVIDIA como respaldo automático.
NVIDIA_API_KEY=

# ─── Control Plane [OPCIONAL] ─────────────────────────────────────
# URL del panel de control de VCOO (onboarding.vercel.app).
# Dejar vacío si no se usa onboarding externo.
CONTROL_PLANE_URL=

# ─── Google OAuth [OPCIONAL - necesario para Gmail/Drive/Calendar] ─
# Se configura mediante el asistente: bash provision/configure-oauth.sh
# No es necesario rellenar aquí: el asistente genera los archivos necesarios.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Claves internas [NO TOCAR] ───────────────────────────────────
MASTER_KEY=
PROVISION_TOKEN=
