# ── Base de datos ──
# Local (Docker): conexión directa está bien.
POSTGRES_URL=postgresql://postgres:password@db:5432/vcoo
# EN VERCEL / SERVERLESS: usa SIEMPRE el connection pooler (Supavisor), que da IPv4.
# La conexión directa (db.<ref>.supabase.co:5432) solo resuelve por IPv6 y FALLA en
# Vercel con "Cannot assign requested address". Formato del pooler (transaction mode):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Criptografía ──
MASTER_KEY=REPLACE_ME_GENERATE_A_SECURE_KEY

# ── Operador inicial (se crea automáticamente si no hay operadores) ──
FIRST_OPERATOR_EMAIL=admin@tu-dominio.com
FIRST_OPERATOR_PASSWORD=cambiar_esto
FIRST_OPERATOR_NAME=Admin

# ── Dashboard fallback (solo para migración, crea cuentas de operador) ──
# DASHBOARD_PASSWORD=versus

# ── Frontend ──
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# ── Control plane (backend URL para el instalador) ──
CONTROL_PLANE=http://localhost:8000

# ── Google OAuth ──
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
