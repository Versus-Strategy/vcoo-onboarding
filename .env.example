# ── Base de datos ──
POSTGRES_URL=postgresql://postgres:password@db:5432/vcoo

# ── Criptografía ──
MASTER_KEY=REPLACE_ME_GENERATE_A_SECURE_KEY

# ── Operador inicial (se crea automáticamente si no hay operadores) ──
FIRST_OPERATOR_EMAIL=admin@tu-dominio.com
FIRST_OPERATOR_PASSWORD=cambiar_esto
FIRST_OPERATOR_NAME=Admin

# ── Dashboard fallback (solo para migración, crea cuentas de operador) ──
# DASHBOARD_PASSWORD=versus

# ── Frontend ──
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# ── Control plane (backend URL para el instalador) ──
CONTROL_PLANE=http://localhost:8000

